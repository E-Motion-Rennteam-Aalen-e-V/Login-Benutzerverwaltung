# Kopiere diese Datei zu ".env" und trage echte Werte ein. ".env" ist in
# .gitignore und wird NIE committed.

# --- GitHub-Backend (Produktion) -------------------------------------------
# Wenn diese drei Werte gesetzt sind, greifen die Scripts/die App direkt auf
# das private GitHub-Repo zu. Fine-grained PAT, beschraenkt auf GENAU dieses
# Repo, Permission "Contents: Read and write" - siehe SECURITY.md.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_BRANCH=main

# Pfade innerhalb des Repos (Defaults passen fuer die meisten Faelle)
CREDENTIALS_FILE_PATH=admins.json
CREDENTIALS_AUDIT_LOG_PATH=audit-log.jsonl

# --- Verschluesselung --------------------------------------------------------
# 32-Byte-Schluessel, base64-kodiert. Erzeugen mit:
#   openssl rand -base64 32
# Wird NICHT im GitHub-Repo abgelegt (sonst waere die Verschluesselung
# wertlos) - nur hier lokal bzw. im Secret-Store der App (Vercel Env,
# GitHub Actions Secret, etc.). Bei fehlendem Wert generiert
# `npm run add-admin` (lokaler Modus) automatisch einen neuen Schluessel.
CREDENTIALS_ENCRYPTION_KEY=
CREDENTIALS_KEY_ID=v1

# --- Cache -------------------------------------------------------------------
CREDENTIALS_CACHE_TTL_MS=60000
